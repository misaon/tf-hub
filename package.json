{
  "name": "@misaon/tf-hub",
  "version": "0.1.1",
  "description": "Command-line client and MCP server for the TF Hub intranet API",
  "keywords": [
    "bun",
    "cli",
    "mcp",
    "model-context-protocol",
    "tf-hub"
  ],
  "homepage": "https://github.com/misaon/tf-hub#readme",
  "bugs": "https://github.com/misaon/tf-hub/issues",
  "license": "MIT",
  "author": "Ondřej Misák <email@ondrejmisak.cz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misaon/tf-hub.git"
  },
  "bin": {
    "tf-hub": "./dist/index.mjs"
  },
  "files": [
    "dist/index.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=node --outfile dist/index.mjs",
    "build:binary": "bun build src/index.ts --compile --outfile dist/tf-hub",
    "generate": "bun scripts/update-openapi.ts && openapi-ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "knip": "knip",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "docs": "automd",
    "prepare": "husky",
    "release": "bun test && changelogen --release --clean --push --no-github",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@hey-api/openapi-ts": "^0.98.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.3.14",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "h3": "^2.0.1-rc.22",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "ofetch": "^1.5.1",
    "open": "^11.0.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "bun": ">=1.2.21",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
