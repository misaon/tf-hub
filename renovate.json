{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard", "schedule:weekly"],
  "lockFileMaintenance": { "enabled": true },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Group and auto-merge dev dependencies once CI passes.",
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies",
      "automerge": true
    },
    {
      "description": "Group and auto-merge GitHub Actions once CI passes.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true
    }
  ]
}
